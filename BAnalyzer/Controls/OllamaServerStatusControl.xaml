<UserControl x:Class="BAnalyzer.Controls.OllamaServerStatusControl" x:Name="Ui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:BAnalyzer.Controls.Converters"
             mc:Ignorable="d" d:DesignWidth="600">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="CellStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>
    <!-- Collapsed by default: a one-line summary that unfolds into the table of the loaded models -->
    <Expander FontSize="11" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
        <Expander.Header>
            <TextBlock Text="{Binding ElementName=Ui, Path=Summary}" FontSize="11"
                       VerticalAlignment="Center" Style="{StaticResource TextBlockStyle}"/>
        </Expander.Header>
        <Grid Margin="24,4,0,0" Grid.IsSharedSizeScope="True"
              Visibility="{Binding ElementName=Ui, Path=HasLoadedModels, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Opacity="0.7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="ModelName"/>
                    <ColumnDefinition SharedSizeGroup="ModelRole"/>
                    <ColumnDefinition SharedSizeGroup="ModelSize"/>
                    <ColumnDefinition SharedSizeGroup="ModelGpu"/>
                    <ColumnDefinition SharedSizeGroup="ModelCpu"/>
                    <ColumnDefinition SharedSizeGroup="ModelKeepAlive"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Model" Style="{StaticResource CellStyle}"/>
                <TextBlock Grid.Column="1" Text="Role" Style="{StaticResource CellStyle}"/>
                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource CellStyle}"/>
                <TextBlock Grid.Column="3" Text="GPU" Style="{StaticResource CellStyle}"/>
                <TextBlock Grid.Column="4" Text="CPU" Style="{StaticResource CellStyle}"/>
                <TextBlock Grid.Column="5" Text="Stays loaded" Style="{StaticResource CellStyle}"/>
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ElementName=Ui, Path=LoadedModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="ModelName"/>
                                <ColumnDefinition SharedSizeGroup="ModelRole"/>
                                <ColumnDefinition SharedSizeGroup="ModelSize"/>
                                <ColumnDefinition SharedSizeGroup="ModelGpu"/>
                                <ColumnDefinition SharedSizeGroup="ModelCpu"/>
                                <ColumnDefinition SharedSizeGroup="ModelKeepAlive"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Role}" Style="{StaticResource CellStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource CellStyle}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Gpu}" Style="{StaticResource CellStyle}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Cpu}" Style="{StaticResource CellStyle}"/>
                            <TextBlock Grid.Column="5" Text="{Binding KeepAlive}" Style="{StaticResource CellStyle}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Expander>
</UserControl>
